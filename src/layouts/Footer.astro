---
// @ts-ignore
// @ts-nocheck
import Wrapper from "../components/common/shared/Wrapper.astro";

import "./footer.scss";
---

<footer class="footer">
  <Wrapper classes="footer-wrapper">
    <div class="footer-policy">
      <ul>
        <li>
          <a href="/privacy-policy">Privacy Policy and Terms</a>
        </li>
      </ul>
    </div>
    <div class="footer-copy">
      <p>Copyright © <span id=" year"></span> RK Group Inc.</p>
    </div>
  </Wrapper>
</footer>

<script>
  const yearSpan = document.getElementById("year");
  yearSpan.innerHTML = `${new Date().getFullYear()}`;
</script>

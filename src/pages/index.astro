---
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/Home/PageIntro/PageIntro.astro";
import ImageByContent from "../components/Home/ImageByContent/ImageByContent.astro";
import Difference from "../components/Home/Difference/Difference.astro";
import ServicesDisplay from "../components/Home/ServicesDisplay/ServicesDisplay.astro";

import { Page_Seo_Query } from "../data/page/queries";
import {
  Page_Intro_Query,
  Image_By_Content_Query,
  Difference_Query,
  Services_Display_Query,
  All_Services_Query,
} from "../data/home/queries";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
		query homePageQuery {
		    page(id: "/", idType: URI) {
          		${Page_Seo_Query}
            	homeTemplate {
              		${Page_Intro_Query}
			  		${Image_By_Content_Query}
			  		${Difference_Query}
			  		${Services_Display_Query}
            	}
          	}
			${All_Services_Query}
        }
	  `,
  }),
});

const {
  data: {
    services,
    page: { seoMetaTags, homeTemplate },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
  isHome={true}
>
  <PageIntro data={homeTemplate.pageIntro} />
  <ImageByContent data={homeTemplate.imageByContent} />
  <Difference data={homeTemplate.difference} />
  <ServicesDisplay data={homeTemplate.servicesDisplay} services={services} />
</Layout>

---
import "./serviceNavigation.scss";
import Wrapper from "../../common/shared/Wrapper.astro";
---

<div class="service-post-nav">
  <Wrapper classes="service-post-nav-wrapper">
    {
      Astro.props.data.prev !== null ? (
        <div
          class={`service-post-nav-prev${Astro.props.data.next === null ? " service-post-nav-prev-alone" : ""}`}
        >
          <a href={`/service/${Astro.props.data.prev.slug}`}>
            <span>&lt;</span>Previous Service
          </a>
        </div>
      ) : null
    }
    <div class="service-post-nav-home">
      <a href={`/`}> Home </a>
    </div>
    {
      Astro.props.data.next !== null ? (
        <div
          class={`service-post-nav-next${Astro.props.data.prev === null ? " service-post-nav-next-alone" : ""}`}
        >
          <a href={`/service/${Astro.props.data.next.slug}`}>
            Next Service<span>&gt;</span>
          </a>
        </div>
      ) : null
    }
  </Wrapper>
</div>

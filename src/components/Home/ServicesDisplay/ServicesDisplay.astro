---
// @ts-ignore
// @ts-nocheck
import Button from "../../common/shared/Button.astro";
import Wrapper from "../../common/shared/Wrapper.astro";
import "./servicesDisplay.scss";
import { Image } from "astro:assets";

const { displayServices, logo, title } = Astro.props.data;
const services = Astro.props.services.edges;

const imageSrc = logo?.node?.sourceUrl;
const imageAlt = logo?.node?.altText || "";
---

{
  displayServices ? (
    <div id="services" class="services-display">
      <Wrapper wrapType="big" classes="services-display-wrapper">
        <div class="services-display-header">
          <div class="services-display-header-logo">
            <Image
              src={imageSrc}
              alt={imageAlt}
              format="webp"
              widths={[800, 1200, 1600, 2000]}
              sizes="100vw"
              loading="eager"
              inferSize={true}
              class=""
            />
          </div>
          <div class="services-display-header-title">
            <h2>{title}</h2>
          </div>
        </div>
        <div class="services-display-container">
          {services.map((service) => {
            const serviceImageSrc =
              service.node.servicesPost.excerptImage?.node?.sourceUrl;
            const serviceImageAlt =
              service.node.servicesPost.excerptImage?.node?.altText || "";

            return (
              <div class="services-display-service">
                <div class="services-display-service-header">
                  <div class="services-display-service-header-image">
                    <Image
                      src={serviceImageSrc}
                      alt={serviceImageAlt}
                      format="webp"
                      widths={[800, 1200, 1600, 2000]}
                      sizes="100vw"
                      loading="eager"
                      inferSize={true}
                      class=""
                    />
                  </div>
                  <div class="services-display-service-header-title">
                    <h3>{service.node.title}</h3>
                  </div>
                </div>
                <div class="services-display-service-excerpt">
                  <div set:html={service.node.servicesPost.excerpt} />
                  <div class="services-display-service-excerpt-link">
                    <a href={`/service/${service.node.slug}`}>Learn More</a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </Wrapper>
    </div>
  ) : null
}

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const header = document.querySelector(".services-display-header");

  const servicesContainer = document.querySelector(
    ".services-display-container",
  );

  const serviceCards = document.querySelectorAll(".services-display-service");

  if (!prefersReducedMotion) {
    if (header) {
      gsap.from(header, {
        y: 40,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",

        scrollTrigger: {
          trigger: header,
          markers: false,
          start: "top 60%",
          toggleActions: "play none none none",
        },
      });
    }
    if (servicesContainer && serviceCards.length) {
      gsap.from(serviceCards, {
        y: 80,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        stagger: {
          each: 0.25,
          from: "start",
        },

        scrollTrigger: {
          trigger: servicesContainer,
          markers: false,
          start: "top 60%",
          toggleActions: "play none none none",
        },
      });
    }
  }
</script>

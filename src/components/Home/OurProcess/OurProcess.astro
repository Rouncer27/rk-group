---
// @ts-ignore
// @ts-nocheck
import Wrapper from "../../common/shared/Wrapper.astro";
import "./ourProcess.scss";

import { Image } from "astro:assets";

import logoIcon from "../../../assets/logo-icon.png";

const { title, steps } = Astro.props.data;
---

<div class="our-process">
  <Wrapper classes="our-process-wrapper">
    <div class="our-process-title">
      <h2>{title}</h2>
    </div>
    <div class="our-process-steps">
      {
        steps.map((step, index) => {
          const imageSrc = step.icon?.node?.sourceUrl;
          const imageAlt = step.icon?.node?.altText || "";

          return (
            <div class="our-process-step">
              <div class="our-process-step-inner">
                <div class="our-process-step-front">
                  <div class="our-process-step-front-inner">
                    <div class="our-process-step-icon">
                      <div class="our-process-step-icon-container">
                        <Image
                          src={imageSrc}
                          alt={imageAlt}
                          format="webp"
                          widths={[800, 1200, 1600, 2000]}
                          sizes="100vw"
                          loading="eager"
                          inferSize={true}
                          class=""
                        />
                      </div>
                    </div>
                    <div class="our-process-step-name">
                      <h3>
                        <span>{index + 1}. </span>
                        {step.name}
                      </h3>
                    </div>
                  </div>
                </div>

                <div class="our-process-step-back">
                  <div class="our-process-step-back-inner">
                    <div
                      class="our-process-step-content"
                      set:html={step.content}
                    />
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
    <div class="our-process-logo-icon">
      <img src={logoIcon.src} alt={"RK Group"} />
    </div>
  </Wrapper>
</div>

<script>
  import gsap from "gsap";

  const cards = document.querySelectorAll(".our-process-step");

  cards.forEach((card) => {
    const inner = card.querySelector(".our-process-step-inner");

    if (!inner) return;

    let isFlipped = false;

    const flip = () => {
      isFlipped = !isFlipped;

      gsap.to(inner, {
        rotationY: isFlipped ? 180 : 0,
        duration: 0.7,
        ease: "power2.inOut",
      });
    };

    // Desktop: hover
    card.addEventListener("mouseenter", () => {
      if (window.matchMedia("(hover: hover)").matches) {
        gsap.to(inner, {
          rotationY: 180,
          duration: 0.7,
          ease: "power2.inOut",
        });
      }
    });

    card.addEventListener("mouseleave", () => {
      if (window.matchMedia("(hover: hover)").matches) {
        isFlipped = false;

        gsap.to(inner, {
          rotationY: 0,
          duration: 0.7,
          ease: "power2.inOut",
        });
      }
    });

    // Mobile/tablet: tap
    card.addEventListener("click", () => {
      if (!window.matchMedia("(hover: hover)").matches) {
        flip();
      }
    });
  });
</script>

---
// @ts-ignore
// @ts-nocheck
import Wrapper from "../../common/shared/Wrapper.astro";
import "./safetyMatters.scss";
import { Image } from "astro:assets";

const {
  heroImage,
  heroTitle,
  heroContent,
  heroBold,
  logosTitle,
  logosContent,
  safetyLogos,
} = Astro.props.data;

const imageSrc = heroImage?.node?.sourceUrl;
const imageAlt = heroImage?.node?.altText || "";
---

<div>
  <Wrapper>
    <div>
      <div class="">
        <Image
          src={imageSrc}
          alt={imageAlt}
          format="webp"
          widths={[800, 1200, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          inferSize={true}
          class=""
        />
      </div>
      <div>
        <h2>{heroTitle}</h2>
      </div>
      <div set:html={heroContent} />
      <div set:html={heroBold} />
    </div>

    <div>
      <div>
        <h2>{logosTitle}</h2>
      </div>
      <div set:html={logosContent} />
      <div>
        {
          safetyLogos.map((logo) => {
            const logoSrc = logo.logo?.node?.sourceUrl;
            const logoAlt = logo.logo?.node?.altText || "";

            return (
              <div class="">
                <div>
                  <Image
                    src={logoSrc}
                    alt={logoAlt}
                    format="webp"
                    widths={[800, 1200, 1600, 2000]}
                    sizes="100vw"
                    loading="eager"
                    inferSize={true}
                    class=""
                  />
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </Wrapper>
</div>
